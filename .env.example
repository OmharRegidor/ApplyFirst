# Copy this file to ".env" and fill it in.  .env is git-ignored — NEVER commit it.

# --- Searches (optional; comma-separated). You can also pass -k on the CLI. ---
APPLYFIRST_KEYWORDS=virtual assistant, customer service

# --- Polling ---
APPLYFIRST_DB=applyfirst.db
APPLYFIRST_POLL_INTERVAL_SECONDS=300

# --- Email alerts via Gmail (free) ---
# Setup (one time):
#   1. Turn on 2-Step Verification:  https://myaccount.google.com/security
#   2. Create an App Password (type "Mail"):  https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password into SMTP_PASSWORD below
#      (it is NOT your normal Gmail password; remove the spaces Google shows).
# Leave EMAIL_ENABLED=false to just preview alerts in the console instead of sending.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=youremail@gmail.com
SMTP_PASSWORD=your16charapppassword
ALERT_TO=youremail@gmail.com
# ALERT_FROM=youremail@gmail.com   # optional; defaults to SMTP_USER
