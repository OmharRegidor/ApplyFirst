[Unit]
Description=ApplyFirst - onlinejobs.ph job catcher (continuous poll loop)
After=network-online.target
Wants=network-online.target
# Crash-loop guard: if it restarts >10 times in 5 min, stop trying (systemd v230+: these live in [Unit]).
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
User=applyfirst
Group=applyfirst
WorkingDirectory=/opt/applyfirst
# python-dotenv auto-loads /opt/applyfirst/.env (secrets live there, mode 600).
# Structured JSON events go to stderr -> journald; human output goes to stdout -> journald.
Environment=APPLYFIRST_LOG_JSON=1
ExecStart=/opt/applyfirst/.venv/bin/python -m applyfirst.cli run
Restart=always
RestartSec=10

# --- hardening (the app only needs to read/write its own dir + make outbound calls) ---
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths=/opt/applyfirst

[Install]
WantedBy=multi-user.target
