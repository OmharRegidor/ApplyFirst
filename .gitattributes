# Files that run on the Linux VM must keep LF endings even when committed from Windows
# (a CRLF in a shell shebang breaks `bash`; systemd is happier with LF too).
*.sh        text eol=lf
*.service   text eol=lf
*.timer     text eol=lf

# The vendored library is pinned by sha256, so a CRLF checkout would change its bytes
# and break the pin. Leave it exactly as committed.
applyfirst/saas/static/vendor/** -text
